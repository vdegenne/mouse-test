{
  "name": "mouse-test",
  "version": "1.0.0",
  "description": "mouse-test",
  "type": "module",
  "author": "Valentin Degenne <vdegenne@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "wireit": {
    "dev": {
      "dependencies": [
        "dev:vite"
      ]
    },
    "build": {
      "dependencies": [
        "build:vite"
      ]
    },
    "build:server": {
      "command": "tsc -p ./tsconfig.server.json",
      "clean": "if-file-deleted",
      "files": [
        "./tsconfig.server.json",
        "./src/server/",
        "./src/shared.ts"
      ],
      "output": [
        "./lib/server/",
        "./lib/shared.js"
      ]
    },
    "serve:server": {
      "service": true,
      "command": "node ./lib/server.js",
      "dependencies": [
        "build:server"
      ],
      "files": []
    },
    "vuc": {
      "service": true,
      "command": "vuc",
      "files": [
        "./.vuc.json"
      ]
    },
    "dev:vite": {
      "service": true,
      "command": "vite --host",
      "files": [],
      "dependencies": [
        "pwa-assets"
      ]
    },
    "build:vite": {
      "command": "vite build",
      "files": [
        "./vite.config.js",
        "./src/",
        "!./src/server/",
        "./index.html",
        "./public"
      ],
      "output": [
        "./dist/"
      ],
      "dependencies": [
        "pwa-assets"
      ]
    },
    "pwa-assets": {
      "command": "pwa-assets-generator --preset minimal-2023 --html.preset 2023 public/logo.svg",
      "files": [
        "public/logo.svg"
      ],
      "output": [
        "public/pwa-64x64.png",
        "public/pwa-192x192.png",
        "public/pwa-512x512.png",
        "public/maskable-icon-512x512.png",
        "public/apple-touch-icon-180x180.png",
        "public/favicon.ico"
      ]
    }
  },
  "devDependencies": {
    "@material/mwc-top-app-bar": "^0.27.0",
    "@material/web": "^2.5.0",
    "@snar/lit": "^1.8.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@vdegenne/about-dialog": "^0.4.2",
    "@vdegenne/debouncer": "^1.0.17",
    "@vdegenne/forms": "^0.1.94",
    "@vdegenne/lit-debug": "^0.1.2",
    "@vdegenne/material-color-helpers": "^1.11.7",
    "@vdegenne/mini-rest": "^0.3.8",
    "@vdegenne/rollup-plugin-minify-html": "^1.0.6",
    "@vdegenne/router": "^0.1.11",
    "@vite-pwa/assets-generator": "^2.0.0",
    "custom-element-decorator": "^0.6.0",
    "html-vision": "^1.0.5",
    "lit": "^3.3.3",
    "lit-with-styles": "^2.1.3",
    "material-3-dialog": "^0.1.14",
    "material-shell": "^1.3.10",
    "rollup-plugin-material-all": "^1.2.3",
    "rollup-plugin-minify-template-literals": "^2.2.0",
    "snar": "^2.3.7",
    "snar-save-to-local-storage": "^1.0.1",
    "tailwindcss": "^4.3.3",
    "toastit": "^2.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-mdicon2svg": "^0.2.4",
    "vite-plugin-pwa": "^2.0.0",
    "vscode-ui-connector": "^0.2.4",
    "wireit": "^0.15.0"
  },
  "scripts": {
    "dev": "wireit",
    "build": "wireit",
    "pwa-assets": "wireit"
  }
}